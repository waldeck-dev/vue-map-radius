{
    "name": "vue-map-radius",
    "private": false,
    "version": "2.0.0",
    "type": "module",
    "description": "A Vue 3 component for radius and polygon visualization on MapTiler maps",
    "files": [
        "dist"
    ],
    "main": "./dist/vue-map-radius.umd.cjs",
    "module": "./dist/vue-map-radius.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/vue-map-radius.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/vue-map-radius.umd.cjs"
            }
        },
        "./style.css": "./dist/vue-map-radius.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "docs:build": "vite build --config vite.docs.config.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src/ docs/",
        "lint:fix": "eslint src/ docs/ --fix",
        "typecheck": "vue-tsc --build",
        "prepublishOnly": "npm run build && node scripts/check-package.mjs",
        "test:coverage": "vitest run --coverage",
        "check:package": "node scripts/check-package.mjs",
        "size": "node scripts/size.mjs"
    },
    "peerDependencies": {
        "maplibre-gl": "^5.0.0",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.12.3",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vitest/coverage-v8": "^4.1.11",
        "@vue/language-core": "3.1.8",
        "@vue/test-utils": "^2.4.10",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.4.1",
        "eslint-plugin-vue": "^10.9.2",
        "globals": "^17.6.0",
        "jsdom": "^29.1.1",
        "maplibre-gl": "^5.24.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.60.1",
        "vite": "^8.0.12",
        "vite-plugin-dts": "^5.0.2",
        "vitest": "^4.1.8",
        "vue": "^3.5.34",
        "vue-tsc": "^3.2.8"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/waldeck-dev/vue-map-radius.git"
    },
    "license": "MIT",
    "sideEffects": [
        "**/*.css"
    ],
    "keywords": [
        "vue",
        "vue3",
        "vue-component",
        "maplibre",
        "maplibre-gl",
        "maptiler",
        "radius",
        "circle",
        "polygon",
        "map"
    ],
    "bugs": {
        "url": "https://github.com/waldeck-dev/vue-map-radius/issues"
    },
    "homepage": "https://github.com/waldeck-dev/vue-map-radius#readme",
    "dependencies": {
        "@types/geojson": "^7946.0.16"
    }
}
