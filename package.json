{
    "name": "vue-map-radius",
    "private": false,
    "version": "0.1.0",
    "type": "module",
    "description": "A Vue 3 component for radius and polygon visualization on MapTiler maps",
    "files": [
        "dist"
    ],
    "main": "./dist/vue-map-radius.umd.cjs",
    "module": "./dist/vue-map-radius.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/src/index.d.ts",
                "default": "./dist/vue-map-radius.js"
            },
            "require": {
                "types": "./dist/src/index.d.ts",
                "default": "./dist/vue-map-radius.umd.cjs"
            }
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src/ dev/",
        "lint:fix": "eslint src/ dev/ --fix"
    },
    "dependencies": {
        "maplibre-gl": "^5.24.0",
        "vue": "^3.5.34"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/geojson": "^7946.0.16",
        "@types/node": "^24.12.3",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/test-utils": "^2.4.10",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.4.1",
        "eslint-plugin-vue": "^10.9.2",
        "globals": "^17.6.0",
        "jsdom": "^29.1.1",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.60.1",
        "vite": "^8.0.12",
        "vite-plugin-dts": "^5.0.2",
        "vitest": "^4.1.8",
        "vue-tsc": "^3.2.8"
    }
}